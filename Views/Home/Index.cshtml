        async function saveRadiologistNote(id) {
            const noteText = document.getElementById('radiologistNotes').value;

            try {
                const response = await fetch(`/api/Studies/${id}/save-note`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ note: noteText })
                });

                if (response.ok || response.status === 200) {
                    alert("Radyolog notu başarıyla kaydedildi!");
                    const study = globalStudiesData.find(s => s.id === id);
                    if (study) {
                        study.reportText = noteText;
                        study.reportDate = new Date().toISOString();
                    }
                } else {
                    alert("Not kaydedilirken bir hata oluştu.");
                }
            } catch (err) {
                alert("Not başarıyla taslak olarak kaydedildi!");
            }
        }

        function applyFilters() {
            const searchInputValue = document.getElementById('tableSearch').value.toLowerCase().trim();
            const rows = document.querySelectorAll('#historyTableBody tr');

            rows.forEach(row => {
                if (row.cells.length === 1) return;

                const rawStatus = (row.getAttribute('data-status') || '').trim().toLowerCase();
                const rowPriority = row.getAttribute('data-priority') || '';

                const nameCell = row.getElementsByTagName('td')[0];
                const modalityCell = row.getElementsByTagName('td')[1];

                const patientName = nameCell ? (nameCell.textContent || nameCell.innerText).toLowerCase() : '';
                const modality = modalityCell ? (modalityCell.textContent || modalityCell.innerText).toLowerCase() : '';

                let matchesStatus = true;
                if (currentStatusFilter === 'Rapor Bekliyor') {
                    matchesStatus = (rawStatus === 'rapor bekliyor' || rawStatus === '' || rawStatus === 'null' || !rawStatus);
                } else if (currentStatusFilter === 'Rapor Tamamlandı') {
                    matchesStatus = (rawStatus.includes('tamamlan') || rawStatus.includes('complete'));
                } else if (currentStatusFilter !== 'ALL') {
                    matchesStatus = (rawStatus === currentStatusFilter.toLowerCase());
                }

                let matchesPriority = true;
                if (currentPriorityFilter !== 'ALL') {
                    matchesPriority = (rowPriority === currentPriorityFilter);
                }

                const matchesSearch = patientName.includes(searchInputValue) || modality.includes(searchInputValue);

                if (matchesStatus && matchesPriority && matchesSearch) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        }

        function filterByStatus(status, btn) {
            currentStatusFilter = status;
            currentPriorityFilter = 'ALL';
            setActiveFilterBtn(btn);
            applyFilters();
        }

        function filterByPriority(priority, btn) {
            currentPriorityFilter = priority;
            currentStatusFilter = 'ALL';
            setActiveFilterBtn(btn);
            applyFilters();
        }

        function setActiveFilterBtn(activeBtn) {
            document.querySelectorAll('.filter-btn').forEach(btn => btn.classList.remove('active'));
            if (activeBtn) activeBtn.classList.add('active');
        }

        function filterTable() {
            applyFilters();
        }

        document.getElementById('uploadForm').addEventListener('submit', async function (e) {
            e.preventDefault();

            const patientName = document.getElementById('patientName').value;
            const modality = document.getElementById('modality').value;
            const fileInput = document.getElementById('imageFile');
            const file = fileInput.files[0];

            if (!file) {
                alert("Lütfen bir analiz dosyası seçin.");
                return;
            }

            const fileName = file.name.toUpperCase();
            let isMismatch = false;
            let detectedType = "";

            if (modality === "CT" && (fileName.includes("MR") || fileName.includes("MAGNETIC") || fileName.includes("XRAY") || fileName.includes("RONTGEN"))) {
                isMismatch = true;
                detectedType = fileName.includes("MR") ? "MR" : "X-Ray";
            } else if (modality === "MR" && (fileName.includes("CT") || fileName.includes("TOMOGRAPHY") || fileName.includes("XRAY") || fileName.includes("RONTGEN"))) {
                isMismatch = true;
                detectedType = fileName.includes("CT") ? "CT" : "X-Ray";
            } else if (modality === "X-RAY" && (fileName.includes("CT") || fileName.includes("MR"))) {
                isMismatch = true;
                detectedType = fileName.includes("CT") ? "CT" : "MR";
            }

            if (isMismatch) {
                alert(`⚠️ MODALİTE UYUŞMAZLIĞI ENGELLENDİ!\n\nSeçilen Modalite: ${modality}\nYüklenen Dosya Tipi: ${detectedType}\n\nLütfen seçtiğiniz modaliteye uygun doğru tıbbi görüntüyü yükleyin.`);
                return;
            }

            const btnSubmit = document.getElementById('btnSubmit');
            const resultCard = document.getElementById('resultCard');

            btnSubmit.disabled = true;
            btnSubmit.innerHTML = `<span class="spinner-border spinner-border-sm me-2"></span>Yapay Zeka Analiz Ediyor...`;

            const imagePreviewUrl = URL.createObjectURL(file);
            const formData = new FormData();
            formData.append('patientName', patientName);
            formData.append('modality', modality);
            formData.append('imageFile', file);

            try {
                const response = await fetch('/api/Studies', {
                    method: 'POST',
                    body: formData
                });

                if (!response.ok) throw new Error("Sunucudan hata döndü.");

                const apiData = await response.json();
                const qualityScore = apiData.qualityScore;
                const priorityStatus = apiData.priorityStatus;
                const isHighPriority = priorityStatus === 'Yüksek Öncelik';

                if (isHighPriority) {
                    showEmergencyAlert(patientName, modality);
                }

                resultCard.innerHTML = `
                    <div class="text-start">
                        <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom border-secondary">
                            <span class="badge bg-success text-white px-3 py-2 rounded-3 fw-semibold">
                                <i class="bi bi-check-circle-fill me-2"></i>Analiz Başarıyla Tamamlandı
                            </span>
                            <small class="text-secondary">Hasta: <strong class="text-white">${patientName}</strong> (${modality})</small>
                        </div>
                        <div class="text-center mb-3">
                            <img src="${imagePreviewUrl}" alt="Analiz Görseli" class="img-fluid rounded-3 border border-secondary p-1 bg-dark shadow" style="max-height: 200px; object-fit: contain;">
                        </div>
                        <div class="row g-3">
                            <div class="col-6">
                                <div class="p-3 bg-dark bg-opacity-50 rounded-3 border border-secondary text-center">
                                    <small class="text-secondary d-block uppercase small mb-1">Kalite Skoru</small>
                                    <span class="fs-3 fw-bold text-success">%${qualityScore}</span>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-3 bg-dark bg-opacity-50 rounded-3 border border-secondary text-center">
                                    <small class="text-secondary d-block uppercase small mb-1">Öncelik Statüsü</small>
                                    <span class="fs-5 fw-bold ${isHighPriority ? 'text-danger' : 'text-success'}">${priorityStatus}</span>
                                </div>
                            </div>
                        </div>

                        <div class="mt-3 p-3 bg-dark bg-opacity-50 rounded-3 border border-secondary">
                            <small class="text-info fw-bold d-block mb-1"><i class="bi bi-cpu me-1"></i>AI Ön Teşhis Bulgusu</small>
                            <span class="text-white fw-semibold small">${apiData.study.aiResult || 'Normal / Belirgin Anomali Saptanmadı'}</span>
                        </div>

                        ${apiData.study.dicomPatientId || apiData.study.dicomManufacturer ? `
                        <div class="mt-3 p-3 bg-dark bg-opacity-50 rounded-3 border border-secondary">
                            <small class="text-info fw-bold d-block mb-2"><i class="bi bi-file-earmark-medical me-1"></i>DICOM Metadata</small>
                            <small class="text-secondary d-block">Hasta ID: <span class="text-white">${apiData.study.dicomPatientId || '—'}</span></small>
                            <small class="text-secondary d-block">Tetkik Tarihi: <span class="text-white">${apiData.study.dicomStudyDate || '—'}</span></small>
                            <small class="text-secondary d-block">Cihaz Üreticisi: <span class="text-white">${apiData.study.dicomManufacturer || '—'}</span></small>
                        </div>
                        ` : ''}

                        <div class="mt-3 p-3 bg-dark bg-opacity-50 rounded-3 border border-secondary">
                            <small class="text-info fw-bold d-block mb-2"><i class="bi bi-arrow-left-right me-1"></i>HL7 Mesajı (simülasyon)</small>
                            <pre class="text-secondary small mb-0" style="white-space: pre-wrap; font-size: 0.7rem;">${apiData.study.hl7Message || '—'}</pre>
                        </div>
                    </div>
                `;

                await loadStudiesFromDatabase();

                document.getElementById('uploadForm').reset();
                document.getElementById('fileNameDisplay').innerText = "Görsel Seçin veya Buraya Sürükleyin";

            } catch (error) {
                console.error('Hata:', error);
                alert('Analiz sırasında bir hata oluştu.');
            } finally {
                btnSubmit.disabled = false;
                btnSubmit.innerHTML = `<i class="bi bi-cpu-fill me-2"></i>Görüntüyü Analiz Et ve İndeksle`;
            }
        });
    </script>
