@{
    ViewData["Title"] = "Akıllı PACS - AI Radyoloji ve Kalite Portalı";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Akıllı PACS Portalı</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css?v=2.0" />

    <style>
        @@media print {
            body {
                visibility: hidden;
            }

            #printableReportArea, #printableReportArea * {
                visibility: visible;
            }

            #printableReportArea {
                position: absolute;
                left: 0;
                top: 0;
                width: 100%;
                color: #000 !important;
                background: #fff !important;
                padding: 20px;
            }

            .no-print {
                display: none !important;
            }
        }
    </style>
</head>
<body>

    <!-- Acil Vaka Bildirimleri İçin Toast Container  -->
    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1080;" id="toastContainer">
        <!-- Dinamik Acil Vaka Bildirimleri Buraya Eklenecek -->
    </div>

    <!-- Üst Navigasyon Barı -->
    <nav class="navbar navbar-expand-lg navbar-dark navbar-pacs sticky-top py-3">
        <div class="container-fluid px-4">
            <a class="navbar-brand d-flex align-items-center gap-3 fw-bold fs-4" href="#">
                <div class="bg-primary bg-gradient p-2 rounded-3 d-flex align-items-center justify-content-center" style="width:42px; height:42px;">
                    <i class="bi bi-cpu-fill text-white fs-4"></i>
                </div>
                <span>Akıllı<span class="text-info">PACS</span> AI Engine</span>
            </a>

            <!-- Dinamik Kullanıcı Alanı ve Çıkış Butonu -->
            <div class="d-flex align-items-center gap-3">
                <div class="text-end d-none d-sm-block">
                    <span class="d-block fw-semibold text-white">
                        <i class="bi bi-person-circle text-info me-1"></i>
                        @(Context.Session.GetString("Username") ?? "Aktif Kullanıcı")
                    </span>
                    <small class="text-info opacity-75">
                        <i class="bi bi-circle-fill text-success fs-6 me-1"></i> PACS Sunucusu Aktif
                    </small>
                </div>
                <a href="/Home/Logout" class="btn btn-outline-danger btn-sm rounded-3 px-3 py-2" title="Oturumu Kapat">
                    <i class="bi bi-box-arrow-right me-1"></i> Çıkış
                </a>
            </div>
        </div>
    </nav>

    <div class="container-fluid px-4 my-4">

        <!-- Sayfa Başlığı ve İstatistik Özeti -->
        <div class="row g-3 mb-4 align-items-center">
            <div class="col-md-6">
                <h2 class="fw-bold mb-1 text-white"><i class="bi bi-grid-1x2 text-info me-2"></i>Görüntü Analiz Paneli</h2>
                <p class="text-secondary mb-0">DICOM ve tıbbi görüntü kalite kontrol sistemi. Yapay zeka tabanlı canlı Laplace varyansı & netlik puanlaması.</p>
            </div>
            <div class="col-md-6 text-md-end">
                <button class="btn btn-outline-info rounded-3 px-3 py-2" id="btnRefresh" onclick="refreshDataWithAnimation()">
                    <i class="bi bi-arrow-repeat me-2" id="refreshIcon"></i>Veritabanını Yenile
                </button>
            </div>
        </div>

        <!-- İstatistik Metrik Kartları -->
        <div class="row g-3 mb-4">
            <div class="col-xl-4 col-md-4">
                <div class="stat-box">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-secondary small fw-medium text-uppercase">Toplam Indekslenen</span>
                            <h2 class="fw-bold text-white mb-0 mt-1" id="statTotalCount">0</h2>
                        </div>
                        <div class="stat-icon bg-info bg-opacity-10 text-info">
                            <i class="bi bi-database-fill-gear"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-4 col-md-4">
                <div class="stat-box">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-secondary small fw-medium text-uppercase">Ortalama Kalite Skoru</span>
                            <h2 class="fw-bold text-success mb-0 mt-1" id="statAvgQuality">%0</h2>
                        </div>
                        <div class="stat-icon bg-success bg-opacity-10 text-success">
                            <i class="bi bi-patch-check-fill"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-4 col-md-4">
                <div class="stat-box">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-secondary small fw-medium text-uppercase">Yüksek Öncelikli (Acil)</span>
                            <h2 class="fw-bold text-danger mb-0 mt-1" id="statPriorityCount">0</h2>
                        </div>
                        <div class="stat-icon bg-danger bg-opacity-10 text-danger">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Ana Çalışma Alanı: Sol Form, Sağ Analiz Çıktısı -->
        <div class="row g-4 mb-4">

            <!-- Sol Panel: Yeni Analiz Formu -->
            <div class="col-lg-5">
                <div class="card-pacs p-4 h-100">
                    <div class="d-flex align-items-center justify-content-between mb-3 border-bottom border-secondary pb-3">
                        <h5 class="fw-bold text-white mb-0"><i class="bi bi-cloud-upload-fill text-info me-2"></i>Yeni Görsel Yükle</h5>
                        <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25">AI Servisi Hazır</span>
                    </div>

                    <form id="uploadForm">
                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-secondary">Hasta Adı ve Soyadı</label>
                            <div class="input-group">
                                <span class="input-group-text bg-dark border-secondary text-secondary"><i class="bi bi-person-vcard"></i></span>
                                <input type="text" class="form-control form-control-pacs" id="patientName" placeholder="Örn: Ahmet Yılmaz" required>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-secondary">Görüntü Modalitesi</label>
                            <select class="form-select form-select-pacs" id="modality" required>
                                <option value="" selected disabled>Modalite Seçiniz...</option>
                                <option value="CT">CT (Bilgisayarlı Tomografi)</option>
                                <option value="MR">MR (Manyetik Rezonans)</option>
                                <option value="X-RAY">X-Ray (Röntgen / Radyografi)</option>
                            </select>
                        </div>

                        <div class="mb-4">
                            <label class="form-label small fw-semibold text-secondary">DICOM / Radyoloji Görseli</label>
                            <div class="upload-zone p-4 text-center" onclick="document.getElementById('imageFile').click()">
                                <i class="bi bi-file-earmark-medical fs-1 text-info opacity-75 d-block mb-2"></i>
                                <span class="fw-medium text-white d-block" id="fileNameDisplay">Görsel Seçin veya Buraya Sürükleyin</span>
                                <small class="text-secondary">PNG, JPG, DICOM (Max 50MB)</small>
                                <input type="file" class="d-none" id="imageFile" accept="image/*,.dcm" onchange="handleFileSelect(this)">
                            </div>
                        </div>

                        <button type="submit" class="btn btn-info w-100 py-2 fs-6 fw-bold rounded-3 shadow-sm text-dark" id="btnSubmit">
                            <i class="bi bi-cpu-fill me-2"></i>Görüntüyü Analiz Et ve İndeksle
                        </button>
                    </form>
                </div>
            </div>

            <!-- Sağ Panel: Son Analiz Sonuç Kartı -->
            <div class="col-lg-7">
                <div class="card-pacs p-4 h-100" id="resultCard">
                    <div class="d-flex flex-column align-items-center justify-content-center h-100 text-center py-5">
                        <div class="rounded-circle bg-dark border border-secondary p-4 mb-3">
                            <i class="bi bi-activity fs-1 text-info opacity-50"></i>
                        </div>
                        <h5 class="text-white fw-semibold">Canlı Analiz Çıktı Ekranı</h5>
                        <p class="text-secondary small mb-0" style="max-width: 400px;">Sol taraftaki hasta bilgilerini doldurup analiz başlattığınızda yapay zeka skorları bu alanda canlı olarak görüntülenecektir.</p>
                    </div>
                </div>
            </div>

        </div>

        <!-- Alt Panel: İş Listesi Tablosu (Worklist) -->
        <div class="row">
            <div class="col-12">
                <div class="card-pacs overflow-hidden">
                    <div class="p-4 border-bottom border-secondary d-flex flex-wrap justify-content-between align-items-center gap-3">
                        <div>
                            <h5 class="fw-bold text-white mb-1"><i class="bi bi-list-task text-info me-2"></i>Radyoloji Worklist (İş Listesi)</h5>
                            <small class="text-secondary">Sistemdeki aktif ve geçmiş tetkiklerin yönetimi</small>
                        </div>

                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <div class="btn-group btn-group-sm" role="group">
                                <button type="button" class="btn btn-outline-info active filter-btn" onclick="filterByStatus('ALL', this); currentPriorityFilter='ALL';">Tümü</button>
                                <button type="button" class="btn btn-outline-warning filter-btn" onclick="filterByStatus('Rapor Bekliyor', this)">
                                    <i class="bi bi-clock-history me-1"></i>Bekleyenler
                                </button>
                                <button type="button" class="btn btn-outline-danger filter-btn" onclick="filterByPriority('HIGH', this)">
                                    <i class="bi bi-exclamation-triangle me-1"></i>Aciller
                                </button>
                                <button type="button" class="btn btn-outline-success filter-btn" onclick="filterByStatus('Rapor Tamamlandı', this)">
                                    <i class="bi bi-check-all me-1"></i>Tamamlananlar
                                </button>
                            </div>

                            <div class="input-group input-group-sm" style="width: 220px;">
                                <span class="input-group-text bg-dark border-secondary text-secondary"><i class="bi bi-search"></i></span>
                                <input type="text" class="form-control form-control-pacs" id="tableSearch" placeholder="Hasta veya Modalite Ara..." onkeyup="filterTable()">
                            </div>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-pacs mb-0 align-middle" id="historyTable">
                            <thead>
                                <tr>
                                    <th>Hasta Bilgisi</th>
                                    <th>Modalite</th>
                                    <th>Kalite & Grafik</th>
                                    <th>Öncelik</th>
                                    <th>Statü</th>
                                    <th>Kayıt Tarihi</th>
                                    <th class="text-end pe-4">İşlemler</th>
                                </tr>
                            </thead>
                            <tbody id="historyTableBody">
                                <tr>
                                    <td colspan="7" class="text-center py-5 text-secondary">
                                        <div class="spinner-border spinner-border-sm text-info me-2" role="status"></div>
                                        Veritabanından veriler yükleniyor...
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- İnceleme Modalı (Viewer Popup) -->
    <div class="modal fade" id="studyDetailModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content card-pacs text-white border-secondary shadow-lg">
                <div class="modal-header border-secondary py-3">
                    <div id="modalPatientName" class="w-100">
                        <i class="bi bi-person-lines-fill text-info me-2"></i>Hasta Detayı
                    </div>
                    <button type="button" class="btn-close btn-close-white ms-2" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>
                <div class="modal-body p-4" id="modalBodyContent">
                    <!-- Dinamik Yüklenecek -->
                </div>
            </div>
        </div>
    </div>

    <!-- Gizli Yazdırma Alanı -->
    <div id="printableReportArea" style="display: none;"></div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        let globalStudiesData = [];
        let currentStatusFilter = 'ALL';
        let currentPriorityFilter = 'ALL';

        document.addEventListener('DOMContentLoaded', function () {
            loadStudiesFromDatabase();
        });

        function handleFileSelect(input) {
            const fileNameDisplay = document.getElementById('fileNameDisplay');
            if (input.files && input.files[0]) {
                fileNameDisplay.innerText = input.files[0].name;
            }
        }

        async function refreshDataWithAnimation() {
            const btn = document.getElementById('btnRefresh');
            const icon = document.getElementById('refreshIcon');

            btn.disabled = true;
            icon.classList.add('spin-animation');

            await loadStudiesFromDatabase();

            setTimeout(() => {
                icon.classList.remove('spin-animation');
                btn.disabled = false;
            }, 500);
        }

        function showEmergencyAlert(patientName, modality) {
            const container = document.getElementById('toastContainer');
            if (!container) return;

            const toastId = 'toast-' + Date.now();
            const toastHTML = `
                <div id="${toastId}" class="toast align-items-center text-white bg-danger border-0 shadow-lg show mb-2" role="alert" aria-live="assertive" aria-atomic="true">
                    <div class="d-flex">
                        <div class="toast-body d-flex align-items-center gap-2">
                            <i class="bi bi-exclamation-triangle-fill fs-3"></i>
                            <div>
                                <strong class="d-block">⚠️ ACİL VAKA TESPİT EDİLDİ!</strong>
                                <small>${patientName} (${modality}) için acil inceleme önerilir.</small>
                            </div>
                        </div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Kapat"></button>
                    </div>
                </div>
            `;

            container.insertAdjacentHTML('beforeend', toastHTML);

            setTimeout(() => {
                const toastEl = document.getElementById(toastId);
                if (toastEl) toastEl.remove();
            }, 6000);
        }

        async function loadStudiesFromDatabase() {
            const historyTableBody = document.getElementById('historyTableBody');

            try {
                const response = await fetch('/api/Studies');
                if (!response.ok) throw new Error(`API Hatası: ${response.status}`);

                const studies = await response.json();
                globalStudiesData = studies;
                historyTableBody.innerHTML = '';

                if (!studies || studies.length === 0) {
                    historyTableBody.innerHTML = `<tr><td colspan="7" class="text-center py-4 text-secondary">Veritabanında henüz kayıtlı bir analiz bulunmuyor.</td></tr>`;
                    updateStats(0, 0, 0);
                    return;
                }

                let totalQuality = 0;
                let priorityCount = 0;

                studies.forEach(study => {
                    totalQuality += study.qualityScore;
                    const isHighPriority = study.priorityScore > 50;
                    if (isHighPriority) priorityCount++;

                    const priorityBadge = isHighPriority
                        ? `<span class="badge badge-priority-high"><i class="bi bi-exclamation-circle me-1"></i>Yüksek</span>`
                        : `<span class="badge badge-priority-normal"><i class="bi bi-check-circle me-1"></i>Normal</span>`;

                    const dateStr = study.createdAt
                        ? new Date(study.createdAt).toLocaleDateString('tr-TR', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute:'2-digit' })
                        : '—';

                    const studyStatus = study.status ? study.status.trim() : 'Rapor Bekliyor';
                    const isCompleted = studyStatus.toLowerCase().includes('tamamlan') || studyStatus.toLowerCase().includes('complete');

                    const statusBadge = isCompleted
                        ? `<span class="badge bg-success text-white px-2 py-1">Rapor Tamamlandı</span>`
                        : `<span class="badge bg-warning text-dark fw-bold px-2 py-1">${studyStatus}</span>`;

                    const row = `
                        <tr data-status="${studyStatus}" data-priority="${isHighPriority ? 'HIGH' : 'NORMAL'}">
                            <td>
                                <span class="fw-semibold text-white d-block">${study.patientName}</span>
                                <small class="text-secondary" style="font-size: 0.75rem;">ID: P${study.id.toString().padStart(5, '0')}</small>
                            </td>
                            <td><span class="badge badge-modality">${study.modality}</span></td>
                            <td style="min-width: 140px;">
                                <div class="d-flex justify-content-between small mb-1">
                                    <span class="text-white fw-bold">%${study.qualityScore}</span>
                                </div>
                                <div class="progress-pacs">
                                    <div class="progress-bar ${study.qualityScore >= 70 ? 'bg-success' : 'bg-warning'}" style="width: ${study.qualityScore}%"></div>
                                </div>
                            </td>
                            <td>${priorityBadge}</td>
                            <td>${statusBadge}</td>
                            <td class="text-secondary small">${dateStr}</td>
                            <td class="text-end pe-3">
                                <button class="btn btn-sm btn-outline-info me-1 rounded-2" title="İncele & Not Ekle" onclick="openStudyModal(${study.id})">
                                    <i class="bi bi-eye"></i>
                                </button>
                                ${!isCompleted ? `
                                    <button class="btn btn-sm btn-success rounded-2" title="Raporu Tamamla" onclick="completeReport(${study.id})">
                                        <i class="bi bi-check-lg"></i>
                                    </button>
                                ` : ''}
                            </td>
                        </tr>
                    `;
                    historyTableBody.insertAdjacentHTML('beforeend', row);
                });

                const avgQuality = Math.round(totalQuality / studies.length);
                updateStats(studies.length, avgQuality, priorityCount);
                applyFilters();

            } catch (error) {
                console.error('Veri çekme hatası:', error);
                historyTableBody.innerHTML = `<tr><td colspan="7" class="text-center py-4 text-danger"><i class="bi bi-exclamation-triangle me-2"></i>Veriler veritabanından alınamadı. API sunucusunu kontrol edin.</td></tr>`;
            }
        }

        function updateStats(total, avgQuality, priorityCount) {
            document.getElementById('statTotalCount').innerText = total;
            document.getElementById('statAvgQuality').innerText = `%${avgQuality}`;
            document.getElementById('statPriorityCount').innerText = priorityCount;
        }

        async function completeReport(id) {
            if (!confirm("Bu çekimin raporunu 'Rapor Tamamlandı' olarak işaretlemek istiyor musunuz?")) return;

            try {
                const response = await fetch(`/api/Studies/${id}/complete-report`, { method: 'POST' });
                if (response.ok) {
                    await loadStudiesFromDatabase();
                } else {
                    alert("Rapor güncellenirken bir hata oluştu.");
                }
            } catch (err) {
                console.error("Hata:", err);
            }
        }

        function toggleHeatmap() {
            const overlay = document.getElementById('heatmapOverlay');
            const btn = document.getElementById('btnToggleHeatmap');
            const badge = document.getElementById('heatmapStatusBadge');

            if (!overlay) return;
            overlay.classList.toggle('active');

            if (overlay.classList.contains('active')) {
                btn.classList.add('active');
                if (badge) badge.innerHTML = '🔥 AI Lezyon Odağı Aktif';
            } else {
                btn.classList.remove('active');
                if (badge) badge.innerHTML = '👁️ Orijinal Görüntü Modu';
            }
        }

        function insertReportTemplate(type, modality) {
            const textarea = document.getElementById('radiologistNotes');
            if (!textarea) return;

            let templateText = "";
            const mod = modality || "TETKİK";

            if (type === 'normal') {
                templateText = `[SONUÇ: NORMAL DEĞERLENDİRME]\n- İnceleme Alanı: ${mod} Çekimi.\n- Parankim dokuları ve fokal alanlar homojen izlenmektedir.\n- Akut patoloji, kitle etkisi veya belirgin lezyon tespiti yapılmamıştır.\n- Klinik ile uyumlu olarak rutin takip önerilir.`;
            } else if (type === 'lesion') {
                templateText = `[SONUÇ: ANOMALİ / FOKAL DÜZENSİZLİK]\n- İnceleme Alanı: ${mod} Çekimi.\n- Yapay zeka destekli ön değerlendirmede şüpheli dokusal lezyon/yoğunluk artışı izlendi.\n- İlgili kesitlerde sınırları net seçilemeyen fokal görünüm mevcuttur.\n- İleri tetkik ve kontrastlı inceleme ile değerlendirilmesi önerilir.`;
            } else if (type === 'repeat') {
                templateText = `[SONUÇ: YETERSİZ GÖRÜNTÜ / TEKRAR ÇEKİM]\n- İnceleme Alanı: ${mod} Çekimi.\n- Görselde yüksek seviyede artefakt/hareket izi tespiti yapılmıştır.\n- Kalite skoru tanısal değer sınırının altındadır.\n- Çekimin uygun protokol ile TEKRARLANMASI rica olunur.`;
            }

            textarea.value = templateText;
        }

        function printReport(studyId) {
            const study = globalStudiesData.find(s => s.id === studyId);
            if (!study) return;

            const notesText = document.getElementById('radiologistNotes').value || 'Henüz eklenmedi.';
            const reportArea = document.getElementById('printableReportArea');

            reportArea.innerHTML = `
                <div style="font-family: Arial, sans-serif; max-width: 800px; margin: 0 auto; color: #000;">
                    <div style="text-align: center; border-bottom: 2px solid #333; padding-bottom: 10px; margin-bottom: 20px;">
                        <h2 style="margin: 0; text-transform: uppercase; color: #0f172a;">AKILLI PACS AI RADYOLOJİ RAPORU</h2>
                        <small style="color: #666;">Yapay Zeka Destekli Görüntüleme & Kalite Kontrol Sistemi</small>
                    </div>

                    <table style="width: 100%; border-collapse: collapse; margin-bottom: 20px; font-size: 14px;">
                        <tr style="border-bottom: 1px solid #ddd;">
                            <td style="padding: 8px; font-weight: bold; width: 20%;">Hasta Adı Soyadı:</td>
                            <td style="padding: 8px; width: 30%;">${study.patientName}</td>
                            <td style="padding: 8px; font-weight: bold; width: 20%;">Hasta ID:</td>
                            <td style="padding: 8px; width: 30%;">P${study.id.toString().padStart(5, '0')}</td>
                        </tr>
                        <tr style="border-bottom: 1px solid #ddd;">
                            <td style="padding: 8px; font-weight: bold;">Modalite:</td>
                            <td style="padding: 8px;">${study.modality}</td>
                            <td style="padding: 8px; font-weight: bold;">Tetkik Tarihi:</td>
                            <td style="padding: 8px;">${study.createdAt ? new Date(study.createdAt).toLocaleString('tr-TR') : '—'}</td>
                        </tr>
                        <tr style="border-bottom: 1px solid #ddd;">
                            <td style="padding: 8px; font-weight: bold;">Sorumlu Doktor:</td>
                            <td style="padding: 8px;">${study.referringPhysician || 'Dr. Mehmet Kaya'}</td>
                            <td style="padding: 8px; font-weight: bold;">Departman:</td>
                            <td style="padding: 8px;">${study.department || 'Radyoloji'}</td>
                        </tr>
                    </table>

                    <div style="background-color: #f8fafc; border: 1px solid #cbd5e1; border-radius: 8px; padding: 15px; margin-bottom: 20px;">
                        <h4 style="margin-top: 0; color: #0284c7; border-bottom: 1px solid #e2e8f0; padding-bottom: 5px;">🤖 Yapay Zeka Değerlendirmesi</h4>
                        <ul style="margin: 0; padding-left: 20px; font-size: 13px; line-height: 1.6;">
                            <li><strong>Kalite Skoru (Laplace Netlik):</strong> %${study.qualityScore}</li>
