@{
    ViewData["Title"] = "Akıllı PACS - Giriş Yap";
    Layout = null; // Giriş sayfasının bağımsız görünmesi için
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Akıllı PACS - Giriş Yap</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #0f172a;
            color: #f8fafc;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .login-card {
            background-color: #1e293b;
            border: 1px solid #334155;
            border-radius: 16px;
            box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.5);
            width: 100%;
            max-width: 420px;
            padding: 2.5rem;
        }

        .form-control-pacs {
            background-color: #0f172a;
            border: 1px solid #334155;
            color: #f8fafc;
            border-radius: 10px;
            padding: 0.75rem 1rem;
        }

            .form-control-pacs:focus {
                background-color: #0f172a;
                border-color: #38bdf8;
                color: #f8fafc;
                box-shadow: 0 0 0 0.25rem rgba(56, 189, 248, 0.15);
            }
    </style>
</head>
<body>

    <div class="login-card">
        <div class="text-center mb-4">
            <div class="bg-primary bg-gradient p-3 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width:60px; height:60px;">
                <i class="bi bi-cpu-fill text-white fs-2"></i>
            </div>
            <h3 class="fw-bold text-white mb-1">Akıllı<span class="text-info">PACS</span> Portalı</h3>
            <p class="text-secondary small">Sisteme erişmek için kimlik bilgilerinizi giriniz.</p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger border-0 bg-danger bg-opacity-10 text-danger py-2 small mb-3 text-center">
                <i class="bi bi-exclamation-triangle-fill me-1"></i> @ViewBag.Error
            </div>
        }

        <form method="post" action="/Home/Login">
            <div class="mb-3">
                <label class="form-label small fw-semibold text-secondary">Kullanıcı Adı</label>
                <div class="input-group">
                    <span class="input-group-text bg-dark border-secondary text-secondary"><i class="bi bi-person"></i></span>
                    <input type="text" name="username" class="form-control form-control-pacs" placeholder="admin" required autofocus>
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label small fw-semibold text-secondary">Şifre</label>
                <div class="input-group">
                    <span class="input-group-text bg-dark border-secondary text-secondary"><i class="bi bi-lock"></i></span>
                    <input type="password" name="password" class="form-control form-control-pacs" placeholder="123456" required>
                </div>
            </div>

            <button type="submit" class="btn btn-info w-100 py-2 fs-6 fw-bold rounded-3 text-dark">
                <i class="bi bi-box-arrow-in-right me-2"></i>Giriş Yap
            </button>
        </form>

        <div class="text-center mt-4">
            <small class="text-secondary">Demo Giriş Bilgileri:<br>Kullanıcı Adı: <strong class="text-white">admin</strong> | Şifre: <strong class="text-white">123456</strong></small>
        </div>
    </div>

</body>
</html>